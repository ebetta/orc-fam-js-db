# A aplicação roda localmente via Express + PostgreSQL.
# A conexão com o Postgres é configurada no topo de server.js, e o frontend
# fala com http://localhost:3001/api.

# --- Integração Pluggy (Open Finance) — opcional ---
# Necessária apenas para a aba "Open Finance" da página Importar.
# Credenciais de uma Development Application criada em https://dashboard.pluggy.ai
# (o cadastro em meu.pluggy.ai sozinho NÃO dá acesso à API).
# Uso pessoal via Conector 200 (Meu Pluggy) é gratuito por tempo indeterminado;
# o trial de 15 dias do Dashboard vale apenas para uso comercial.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Item IDs (UUID) das conexões, separados por vírgula. Copie cada um na
# Demo Application do dashboard, após vincular sua conta do meu.pluggy.ai.
PLUGGY_ITEM_IDS=
